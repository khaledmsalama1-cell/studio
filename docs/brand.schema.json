{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand DNA",
  "type": "object",
  "required": ["name", "slug", "visual", "voice"],
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "tagline": { "type": "string" },
    "website": { "type": "string" },
    "language": { "type": "string", "description": "BCP-47 code used for voice + transcription, e.g. en, ar, es" },
    "essence": {
      "type": "object",
      "properties": {
        "mission": { "type": "string" },
        "positioning": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "personality": { "type": "array", "items": { "type": "string" } },
        "archetype": { "type": "string" }
      }
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "pains": { "type": "array", "items": { "type": "string" } },
          "desires": { "type": "array", "items": { "type": "string" } },
          "objections": { "type": "array", "items": { "type": "string" } },
          "platforms": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "tone": { "type": "array", "items": { "type": "string" } },
        "do": { "type": "array", "items": { "type": "string" } },
        "dont": { "type": "array", "items": { "type": "string" } },
        "vocabulary": {
          "type": "object",
          "properties": { "use": { "type": "array", "items": { "type": "string" } }, "avoid": { "type": "array", "items": { "type": "string" } } }
        },
        "examples": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual": {
      "type": "object",
      "required": ["colors", "fonts"],
      "properties": {
        "colors": {
          "type": "object",
          "required": ["primary", "secondary", "accent", "background", "ink", "muted"],
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "fonts": {
          "type": "object",
          "properties": {
            "display": { "$ref": "#/$defs/font" },
            "body": { "$ref": "#/$defs/font" }
          }
        },
        "logo": { "type": "object", "additionalProperties": { "type": "string" } },
        "radius": { "type": "number" },
        "imagery": { "type": "string" },
        "motion": {
          "type": "object",
          "properties": {
            "energy": { "enum": ["calm", "medium", "high"] },
            "ease": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "provider": { "enum": ["elevenlabs", "kokoro", "file"] },
              "voice_id": { "type": "string" },
              "model_id": { "type": "string" },
              "settings": { "type": "object" },
              "description": { "type": "string" }
            }
          }
        },
        "music": { "type": "string" }
      }
    },
    "products": { "type": "array", "items": { "type": "object" } },
    "content_pillars": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" } } } },
    "ctas": { "type": "array", "items": { "type": "string" } },
    "platforms": { "type": "object" },
    "hashtags": { "type": "object" }
  },
  "$defs": {
    "font": {
      "type": "object",
      "required": ["family"],
      "properties": { "family": { "type": "string" }, "weight": { "type": "number" }, "google": { "type": "boolean" } }
    }
  }
}
