# Copy to .env and fill in only what you use. Never commit .env (git ignores it).
# The studio also writes keys here for you from Settings and the Apps page.

# --- Voice ---
ELEVENLABS_API_KEY=
# Fallback voice when a brand has no voice_id yet
ELEVENLABS_VOICE_ID=

# --- Social research (docs/social-research.md) ---
# Apify: Instagram profiles, Facebook pages, TikTok fallback
APIFY_TOKEN=
# Official Meta Graph API: Instagram Business Discovery + your Facebook Pages
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Override the Graph API version (optional)
META_GRAPH_VERSION=

# --- AI generation and publishing (added from the Apps page) ---
FAL_KEY=
REPLICATE_API_TOKEN=
POSTIZ_API_KEY=

# Any other app on the Apps page adds its own key name here when you connect it
